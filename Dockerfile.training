# --- Stage 1: Build Stage ---
# This stage installs compilers and builds dependencies
FROM python:3.10-slim AS builder

# Set environment variables for build efficiency
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app

# Install system dependencies needed for compiling certain Python wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install 'uv' by copying the binary from the official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy only dependency files first to maximize Docker layer caching
COPY pyproject.toml uv.lock ./

# Install dependencies into the virtual environment
RUN uv sync --frozen --no-dev --no-install-project

# --- Stage 2: Runtime Stage ---
# This is the final image that will be deployed
FROM python:3.10-slim

# Re-apply runtime-specific environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Copy the pre-built virtual environment from the builder stage
COPY --from=builder /opt/venv /opt/venv

# Copy the application source code
COPY . .

EXPOSE 8000

# Metadata labels
LABEL org.opencontainers.image.source=https://github.com/labicdna/desinformacao-painel-saude
LABEL org.opencontainers.image.description="Container image to retrain misinformation classification models"
LABEL org.opencontainers.image.licenses=MIT

# Run the training API directly using the environment's python
CMD ["python", "api_training.py"]
